# Steal the VFY — copy to .env on the host. NEVER commit a filled-in .env.
# HMAC secret issued by the dashboard (Rotate Secret). Required for live.
AGENT_GAMES_HMAC_SECRET=
# HMAC header format: hex (default) or sha256=
AGENT_GAMES_HMAC_FORMAT=hex
# Strategy params: extract amount, fortify threshold, hold threshold, mode,
# then 4 reserved zeros. Default: extract 5; fortify when self < 50;
# never hold-on-low-opponent; mode 0 (normal). See server.js header for
# the reverse-engineered semantics.
STEAL_STRATEGY_PARAMS=5,50,0,0,0,0,0,0
# Strategy salt (32-byte hex). MUST stay stable after the commitment is
# registered in the dashboard — changing it breaks every later proof.
# Generate one (e.g. openssl rand -hex 32) and keep it secret.
STEAL_STRATEGY_SALT=
# Port / host
PORT=8788
HOST=0.0.0.0
