# Copy to .env on the host (or set as host secrets). NEVER commit a real secret.
# Dashboard-issued HMAC secret (after registration; "Rotate Secret" in dashboard)
AGENT_GAMES_HMAC_SECRET=
# HMAC format: hex (default) or sha256=
AGENT_GAMES_HMAC_FORMAT=hex
# task_id -> field mapping: keccak (default), numeric, hex — see README open item 1
GATEKEEPER_TASK_ID_MODE=keccak
PORT=8787
HOST=0.0.0.0
